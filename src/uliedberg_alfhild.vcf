BEGIN:VCARD
VERSION:3.0
N:{{ person.family_name }};{{ person.given_name }};;;
FN:{{ person.given_name }} {{ person.family_name }}
ORG:{{ company.legal_name }}
TEL;TYPE=WORK,VOICE:{{ contact.phone | phone_vcard }}
EMAIL;TYPE=PREF,INTERNET:{{ contact.email }}
ADR;TYPE=WORK:;;;{{ address.locality }};;;{{ address.country_name }}
URL;TYPE=WORK:{{ company.url }}
URL:{{ contact.linkedin }}
REV:{{ vcard.rev }}
END:VCARD
